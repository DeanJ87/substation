# Copy to .env beside compose.yml and fill in. Nothing here goes in a repository.

# Release to run: 1.4.2, 1.4, latest, edge, or a commit
SUBSTATION_VERSION=latest

# Where SubStation keeps its own files: station/ (work, previews, masters), postgres/ and catalogues/ (Siril's
# star catalogues, for plate solving). Fast local storage.
SUBSTATION_DATA=/srv/substation

# The database password: any long random text (openssl rand -hex 24)
SUBSTATION_DB_PASSWORD=


# Your images, mounted read-only; the name is how it shows in SubStation
SUBSTATION_LIBRARY=/srv/photos/astro
SUBSTATION_LIBRARY_NAME=library
SUBSTATION_LIBRARY_MODE=ro
# A second library (an archive), optional
# SUBSTATION_LIBRARY_2=/srv/photos/archive
# SUBSTATION_LIBRARY_2_NAME=archive

SUBSTATION_ADMIN_USERNAME=admin
SUBSTATION_ADMIN_PASSWORD=change-me

# Host port for the web app, or the public address when behind a reverse proxy
SUBSTATION_PORT=8080
# SUBSTATION_URL=https://substation.example.com
# SUBSTATION_DOMAIN=substation.example.com   (compose.traefik.yml)

# Workers: containers × workers in each, and what each container may use
SUBSTATION_WORKER_REPLICAS=1
SUBSTATION_WORKERS_EACH=2
SUBSTATION_WORKER_CPUS=4
SUBSTATION_WORKER_MEMORY=8g

# Post-processing helpers (spec 010): a token they sign in with, and keep their jobs off these workers
# SUBSTATION_HELPER_TOKEN=
# SUBSTATION_SKIP_QUEUES=finish,finish_ctl
